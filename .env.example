# Copy to .env.local for local development.
# These two values are PUBLIC by design (they are shipped to the browser).
# Data is protected by Row Level Security, not by hiding these keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Set to "true" after enabling the Google provider in Supabase Auth.
VITE_ENABLE_GOOGLE=false

# NEVER put the service_role key or database password in any VITE_ variable or in this repo.
